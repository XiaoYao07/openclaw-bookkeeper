{
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com/v1",
        "apiKey": "你的DeepSeek-API-Key",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-v4-flash",
            "name": "DeepSeek V4 Flash",
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "deepseek/deepseek-v4-flash"
      },
      "workspace": "C:/Users/你的用户名/.openclaw/workspace"
    }
  },
  "gateway": {
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "改成你自己的密码"
    },
    "reload": {
      "mode": "hybrid"
    },
    "mode": "local"
  },
  "channels": {
    "openclaw-weixin": {
      "enabled": true,
      "dmPolicy": "open",
      "groupPolicy": "disabled",
      "allowFrom": ["*"]
    }
  },
  "plugins": {
    "entries": {
      "openclaw-weixin": {
        "enabled": true
      }
    }
  },
  "skills": {
    "entries": {
      "bookkeeping": {
        "enabled": true
      }
    }
  }
}
